@Library('shared-libs') _

pipeline {
    environment {
        branchname =  env.BRANCH_NAME.toLowerCase()
        SONAR_PROJECT = "SME-Airflow"
        TELEGRAM_CHAT_ID = 'telegramChatIdTest'
    }

    agent { kubernetes { 
            label 'builder-debian'
            defaultContainer 'builder-debian'
        }
    }

    options {
        gitLabConnection('sme-gitlab')
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds()
        timestamps()
        parallelsAlwaysFailFast()
    }

    stages {
        stage('Gitlab update status') {
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('MR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    } else {
                        return ['test', 'homolog', 'master'].contains(env.BRANCH_NAME)
                    }
                }
            } 
            steps {
                script {
                    env.failedStage = env.STAGE_NAME

                    updateGitlabCommitStatus(
                        name: 'Jenkins CI/CD',
                        state: 'running'
                    )
                }
            }
        }

        stage('Lint') {
            agent { kubernetes { 
                    label 'python312'
                    defaultContainer 'python312'
                }
            }
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('MR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    }
                }
            } 
            steps {
                script {
                    env.failedStage = env.STAGE_NAME

                    sh '''
                        pip install pip
                        pip install ruff
                        ruff check dags/ plugins/ --fix
                    '''
                }
            }
        }

        stage('Testes') {
            agent { kubernetes { 
                    label 'python312'
                    defaultContainer 'python312'
                }
            }
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('MR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    }
                }
            } 
            steps {
                script {
                    env.failedStage = env.STAGE_NAME

                    sh "apt-get update && apt-get install -y --no-install-recommends curl gnupg2 ca-certificates openjdk-17-jre-headless unixodbc unixodbc-dev"
                    sh "pip install apache-airflow==3.2.1 --constraint \"https://raw.githubusercontent.com/apache/airflow/constraints-3.2.1/constraints-3.12.txt\""
                    sh "pip install apache-airflow-providers-postgres"

                    pythonTest(
                        requirementsDir: "requirements/local.txt",
                        withMigration: "false",
                        credentialEnv: "",
                        testCommand: "coverage run -m pytest"
                    )
                }
            }
        }

        stage('SonarQube') {
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('MR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    
                    sonarqubePython(
                        dockerfilePath: "./Dockerfile",
                        coverageExclusions: "Dockerfile.dev,Dockerfile,**/testes/**,cypress.config.js,**/migrations/**,config/**,docs/**,**/tests/**,**__init__.py",
                        sonarExclusions: "Dockerfile.dev,**/testes/**,cypress.config.js,**__init__.py"
                    )
                }
            }
        }

        stage("Sonar Quality Gate") {
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('MR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    timeout(15) {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Pipeline aborted due to quality gate failure: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('Deploy QA - sync DAGs') {
            when {
                branch 'test'
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    withCredentials([
                        sshUserPrivateKey(credentialsId: 'jenkins_airflow_deploy_rls', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                        string(credentialsId: 'airflow-host-rls', variable: 'AIRFLOW_HOST')
                    ]) {
                        sh '''
                            ssh -i $SSH_KEY -o StrictHostKeyChecking=no $SSH_USER@$AIRFLOW_HOST "
                                echo Atualizando airflow no host: $HOSTNAME
                            "
                        '''
                    }
                }
            }
        }
    }

    post {
        always { archiveArtifacts artifacts: "coverage.xml", allowEmptyArchive: true }
        success { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'success'
            )
            successTelegram(env.TELEGRAM_CHAT_ID) 
        }
        unstable { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'failed'
            )
            unstableTelegram(env.TELEGRAM_CHAT_ID) 
        }
        failure { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'failed'
            )
            failureTelegram(env.failedStage, env.TELEGRAM_CHAT_ID) 
        }
        aborted { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'canceled'
            )
            abortedTelegram(env.TELEGRAM_CHAT_ID) 
        }
        cleanup { cleanWs() }
    }
}