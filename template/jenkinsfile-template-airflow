@Library('shared-libs') _

pipeline {
    environment {
        branchname = "${env.gitlabBranch?.toLowerCase() ?: ''}"
        TELEGRAM_CHAT_ID = 'telegramChatIdTest' 
    }

    agent { kubernetes { 
            label 'python312'
            defaultContainer 'python312'
        }
    }

    options {
        gitLabConnection('sme-gitlab')
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds()
        timestamps()
        parallelsAlwaysFailFast()
    }

    triggers {
        gitlab(
            triggerOnPush: true,
            triggerOnMergeRequest: true,
            branchFilterType: 'All',
            triggerOnAcceptedMergeRequest: true,
            triggerOnClosedMergeRequest: false,
            cancelPendingBuildsOnUpdate: true,
            cancelRunningBuildsOnUpdate: true
        )
    }

    stages {
        stage('Update status') {
            when {
                expression {
                    return env.gitlabTargetBranch?.startsWith('test') &&
                           env.gitlabSourceBranch?.startsWith('feat')
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME

                    updateGitlabCommitStatus(
                        name: 'Jenkins CI/CD',
                        state: 'running'
                    )
                }
            }
        }

        stage('Testes') {
            when {
                expression {
                    return env.gitlabTargetBranch?.startsWith('test') &&
                           env.gitlabSourceBranch?.startsWith('feat')
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME

                    pythonTest(
                        requirementsDir: "requirements/local.txt",
                        withMigration: "false",
                        credentialEnv: "",
                        testCommand: "pytest tests/"
                    )
                }
            }
        }
    }

    post {
        always { archiveArtifacts artifacts: "coverage.xml", allowEmptyArchive: true }
        success { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'success'
            )
            successTelegram(env.TELEGRAM_CHAT_ID) 
        }
        unstable { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'failed'
            )
            unstableTelegram(env.TELEGRAM_CHAT_ID) 
        }
        failure { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'failed'
            )
            failureTelegram(env.failedStage, env.TELEGRAM_CHAT_ID) 
        }
        aborted { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'canceled'
            )
            abortedTelegram(env.TELEGRAM_CHAT_ID) 
        }
        cleanup { cleanWs() }
    }
}