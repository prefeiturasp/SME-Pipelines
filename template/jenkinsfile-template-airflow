@Library('shared-libs') _

pipeline {
    environment {
        branchname =  env.gitlabBranch.toLowerCase()
        kubeconfig = getKubeconf(env.branchname)
        namespace = "${env.branchname == 'test' ? 'testes' : env.branchname == 'homolog' ? 'testes-hom' : 'testes-prod' }"
        registryCredential = 'svc_jenkins'
        registryUrl = 'registryEndpoint'
        TELEGRAM_CHAT_ID = 'telegramChatIdTest' 
        SONAR_PROJECT = "DEVOPS-TESTES"
    }

    agent { kubernetes { 
            label 'python312'
            defaultContainer 'python312'
        }
    }

    options {
        gitLabConnection('sme-gitlab')
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds()
        timestamps ()
        parallelsAlwaysFailFast()
    }

    triggers {
        smegitlab(
            triggerOnPush: true,
            triggerOnMergeRequest: true,
            branchFilterType: 'All'
        )
    }

    stages {
        stage('Update status') {
            when {
                expression {
                    if (env.gitlabTargetBranch.startsWith('test')) {
                        return ['feat'].contains(env.gitlabSourceBranch)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    
                    updateGitlabCommitStatus(
                        name: 'Jenkins CI/CD',
                        state: 'running'
                    )
                }
            }
        }
        
        stage('Testes') {
            when {
                expression {
                    if (env.gitlabTargetBranch.startsWith('test')) {
                        return ['feat'].contains(env.gitlabSourceBranch)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    
                    pythonTest(
                        requirementsDir: "requirements/local.txt",
                        withMigration: "false",
                        credentialEnv: "",
                        testCommand: "pytest tests/"
                    )
                }
            }
        }
    }

    post {
        always { archiveArtifacts artifacts: "coverage.xml", allowEmptyArchive: true }
        success { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'success'
            )
            successTelegram(env.TELEGRAM_CHAT_ID) 
        }
        unstable { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'failed'
            )
            unstableTelegram(env.TELEGRAM_CHAT_ID) 
        }
        failure { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'failed'
            )
            failureTelegram(env.failedStage, env.TELEGRAM_CHAT_ID) 
        }
        aborted { 
            updateGitlabCommitStatus(
                name: 'Jenkins CI/CD',
                state: 'canceled'
            )
            abortedTelegram(env.TELEGRAM_CHAT_ID) 
        }
        cleanup { cleanWs() }
    }
}