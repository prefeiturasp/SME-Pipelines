@Library('shared-libs') _

pipeline {
    environment {
        branchname =  env.BRANCH_NAME.toLowerCase()
        kubeconfig = getKubeconf(env.branchname)
        namespace = "${env.branchname == 'test' ? 'testes-qa' : env.branchname == 'homolog' ? 'testes-hom' : 'testes' }"
        
        TELEGRAM_CHAT_ID = 'telegramChatIdTest' 
        SONAR_PROJECT = "DEVOPS-TESTES"
        REPO_NAME = "prefeiturasp/repo-name"
        GRUPO_APROVADORES = 'aprovadores-x'
        DOTNET_DEFAULT = "dotnet-5"

        // Credenciais Registry
        registryCredential = 'svc_jenkins'
        registryUrl = 'registryEndpoint'
        project = 'harbor-project-name'
    }

    agent { kubernetes { 
            label 'builder-debian'
            defaultContainer 'builder-debian'
        }
    }
    
    options {
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds()
        timestamps ()
    }

    stages {
        stage('Testes') {
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('PR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    } else {
                        return ['test', 'homolog', 'master'].contains(env.BRANCH_NAME)
                    }
                }
            }
            parallel {
                stage('ApiTeste') {
                    agent { kubernetes { label 'builder-debian'; defaultContainer 'builder-debian' } }
                    steps {
                        testDotnet([
                            testTool: "dotnet-test",
                            projectPath: "SME.SGP.Api.Teste",
                            stashName: "ApiTeste",
                            dotnetVersion: env.DOTNET_DEFAULT
                        ]) 
                    }
                }

                stage('AplicacaoTeste') {
                    agent { kubernetes { label 'builder-debian'; defaultContainer 'builder-debian' } }
                    steps {
                        testDotnet([
                            testTool: "dotnet-test",
                            projectPath: "teste/SME.SGP.Aplicacao.Teste",
                            stashName: "AplicacaoTeste",
                            dotnetVersion: env.DOTNET_DEFAULT
                        ])
                    }
                }
            }
        }

        stage('SonarQube') {
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('PR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    } else {
                        return ['test', 'homolog', 'master'].contains(env.BRANCH_NAME)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    
                    unstash 'ApiTeste'
                    unstash 'AplicacaoTeste'
                    
                    sonarqubeDotnet(
                        dotnetVersion: env.DOTNET_DEFAULT,
                        coverageType: "dotnet-coverage",
                        project: "SME.SGP.sln",
                        coverageExclusions: "Dockerfile.dev,**/teste/**,**/*Dto.cs,**/*ViewModel.cs,**/Migrations/**",
                        sonarExclusions: "Dockerfile.dev,teste/**,**/Configurations/**,**/*Dto.cs,**/*ViewModel.cs,**/Startup.cs,**/Program.cs"
                    )
                }
            }
        }

        stage("Sonar Quality gate") {
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('PR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    } else {
                        return ['test', 'homolog', 'master'].contains(env.BRANCH_NAME)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    timeout(15) {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Pipeline aborted due to quality gate failure: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('Dockerfile Check') {
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('PR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    dockerfileCheck(
                        imageName: "sme-app",
                        dockerfilePath: "src/SME.SGP.Api/Dockerfile"
                    )
                }
            }
        }

        stage('Build') {
            when { anyOf { branch 'master'; branch 'main'; branch 'homolog'; branch 'test'; } }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    buildImage(
                        imageName: "sme-app",
                        sendRegistry: "yes",
                        dockerfilePath: "src/SME.SGP.Api/Dockerfile"
                    )
                }
            }
        }

        stage('Aprovação Prod') {
            when { anyOf { branch 'master'; } }
            steps {
                script{
                    env.failedStage = env.STAGE_NAME
                    
                    approveProd(
                        aprovadoresCredentialsId: env.GRUPO_APROVADORES
                    )
                }
            }
        }

        stage('Deploy') {
            when { anyOf { branch 'master'; branch 'homolog'; branch 'test'; } } 
            steps {
                script{
                    env.failedStage = env.STAGE_NAME
                    
                    restartDeployment(
                        deploymentName: "sme-app",
                        namespace: env.namespace
                    )
                }
            }
        }

        stage('Flyway') {
            agent { kubernetes { 
                    label 'flyway'
                    defaultContainer 'flyway'
                }
            }
            when { anyOf { branch 'master'; branch 'homolog'; branch 'test'; } }
            steps{
                script {
                    failedStage = env.STAGE_NAME
                    withCredentials([string(credentialsId: "flyway_app_${branchname}", variable: 'url')]) {
                        sh 'flyway -url=$url -locations="filesystem:scripts" -outOfOrder=true migrate'
                    }
                }
            }
        }
    }

    post {
        always { archiveArtifacts artifacts: "**/coverage.opencover.xml", allowEmptyArchive: true } // conforme a tool do teste coverage.xml ou coverage.opencover.xml
        success { successTelegram(env.TELEGRAM_CHAT_ID) }
        unstable { unstableTelegram(env.TELEGRAM_CHAT_ID) }
        failure { failureTelegram(env.failedStage, env.TELEGRAM_CHAT_ID) }
        aborted { abortedTelegram(env.TELEGRAM_CHAT_ID) }
        cleanup { cleanWs() }
    }
}