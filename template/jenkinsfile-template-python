@Library('shared-libs') _

pipeline {
    environment {
        branchname =  env.BRANCH_NAME.toLowerCase()
        kubeconfig = getKubeconf(env.branchname)
        namespace = "${env.branchname == 'test' ? 'testes-qa' : env.branchname == 'homolog' ? 'testes-hom' : 'testes' }"
        
        TELEGRAM_CHAT_ID = 'telegramChatIdTest' 
        SONAR_PROJECT = "DEVOPS-TESTES"
        REPO_NAME = "prefeiturasp/repo-name"
        GRUPO_APROVADORES = 'aprovadores-x'

        // Credenciais Registry
        registryCredential = 'svc_jenkins'
        registryUrl = 'registryEndpoint'
        project = 'harbor-project-name'
    }

    agent { kubernetes { 
            label 'builder-debian'
            defaultContainer 'builder-debian'
        }
    }

    options {
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds()
        timestamps ()
    }

    stages {
        stage('Testes') {
            agent { kubernetes { 
                    label 'python312'
                    defaultContainer 'python312'
                }
            }
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('PR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    } else {
                        return ['test', 'homolog', 'master'].contains(env.BRANCH_NAME)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    
                    pythonTest(
                        requirementsDir: "requirements/local.txt",
                        withMigration: "true",
                        credentialEnv: "app_hom_env",
                        testCommand: "coverage run -m pytest"
                    )
                }
            }
        }

        stage('SonarQube') {
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('PR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    } else {
                        return ['test', 'homolog', 'master'].contains(env.BRANCH_NAME)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    
                    sonarqubePython(
                        dockerfilePath: "./Dockerfile",
                        coverageExclusions: "Dockerfile*,**/testes/**,cypress.config.js,**/migrations/**,config/**,docs/**,**/tests/**",
                        sonarExclusions: "Dockerfile.dev,**/testes/**,cypress.config.js"
                    )
                }
            }
        }

        stage("Sonar Quality Gate") {
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('PR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    } else {
                        return ['test', 'homolog', 'master'].contains(env.BRANCH_NAME)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    timeout(15) {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Pipeline aborted due to quality gate failure: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('Dockerfile Check') {
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('PR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    dockerfileCheck(
                        imageName: "sme-app",
                        dockerfilePath: "Dockerfile"
                    )
                }
            }
        }

        stage('Build') {
            when { anyOf { branch 'master'; branch 'homolog'; branch 'test'; } }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    buildImage(
                        imageName: "sme-app",
                        sendRegistry: "yes",
                        dockerfilePath: "Dockerfile"
                    )
                }
            }
        }

        stage('Aprovação Prod') {
            when { anyOf { branch 'master'; } }
            steps {
                script{
                    env.failedStage = env.STAGE_NAME
                    
                    approveProd(
                        aprovadoresCredentialsId: env.GRUPO_APROVADORES
                    )
                }
            }
        }

        stage('Deploy') {
            when { anyOf { branch 'master'; branch 'homolog'; branch 'test'; } }
            steps {
                script{
                    env.failedStage = env.STAGE_NAME
                    
                    restartDeployment(
                        deploymentName: "sme-app",
                        namespace: env.namespace // valor obtido do environment
                    )
                }
            }
        }

        stage('Deploy Sphinx') {
            agent { kubernetes { 
                    label 'python312'
                    defaultContainer 'python312'
                }
            }
            when {
                expression {
                    if (env.BRANCH_NAME.startsWith('PR-')) {
                        return ['test', 'homolog'].contains(env.CHANGE_TARGET)
                    } else {
                        return ['master'].contains(env.BRANCH_NAME)
                    }
                }
            }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    
                    sphinxDeploy(
                        repo: env.REPO_NAME,
                        credentialsId: "github-token-releases"
                    )
                }
            }
        }
        
        stage('Publica release') {
            when { anyOf { branch 'master'; } }
            steps {
                script {
                    env.failedStage = env.STAGE_NAME
                    publishRelease(
                        repo: env.REPO_NAME,
                        credentialsId: "github-token-releases"
                    )
                }
            }
        }
    }

    post {
        always { archiveArtifacts artifacts: "coverage.xml", allowEmptyArchive: true }
        success { successTelegram(env.TELEGRAM_CHAT_ID) }
        unstable { unstableTelegram(env.TELEGRAM_CHAT_ID) }
        failure { failureTelegram(env.failedStage, env.TELEGRAM_CHAT_ID) }
        aborted { abortedTelegram(env.TELEGRAM_CHAT_ID) }
        cleanup { cleanWs() }
    }
}